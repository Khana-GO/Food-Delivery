# EXPO_PUBLIC_* values are inlined into the bundle at build time — never put
# secrets here.

# Where the API lives. Include the /api prefix.
# Web / simulator:
EXPO_PUBLIC_API_URL_WEB=http://localhost:3000/api
# Physical device (Expo Go or a dev build): your machine's LAN IP, e.g.
EXPO_PUBLIC_API_URL_MOBILE=http://192.168.1.5:3000/api

# Google sign-in (must match GOOGLE_CLIENT_ID on the API).
# The web client id is used as the idToken audience on every platform.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# iOS OAuth client id (native builds). Its reversed form is generated into the
# iOS URL scheme by app.config.ts.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
