# Server
PORT=3000
NODE_ENV=development

# CORS / callback hosts
# Dev with Expo Go on a PHONE: FRONTEND_URL_IP must be your dev machine's LAN IP
# (e.g. http://192.168.1.5:8081) – the phone reaches the bundler there. It is
# used for eSewa callback URLs so the app can intercept them.
FRONTEND_URL_WEB=http://localhost:8081
FRONTEND_URL_IP=http://192.168.1.5:8081

# eSewa payment
# CRITICAL: EPAYTEST is a TEST-ONLY merchant and only works on the RC sandbox.
# Do NOT set ESEWA_BASE_URL=https://epay.esewa.com.np (production) while using
# EPAYTEST – every payment will fail/cancel. For RC testing set
# ESEWA_BASE_URL=https://rc-epay.esewa.com.np or leave it unset (auto-selected).
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://rc-epay.esewa.com.np

# Database (Neon)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@your-host.neon.tech/neondb?sslmode=require

# JWT / Auth
JWT_SECRET=change-me-to-a-minimum-32-character-string
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=15d
SALT_ROUNDS=10

# Mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password-here
MAIL_FROM="KhanaGo <your-email@gmail.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI (optional - agent works without via rule-based fallback)
# OpenRouter (recommended, truly free, no card): https://openrouter.ai/keys
# OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-3.5-turbo:free
# Groq (free): https://console.groq.com/keys
# OPENAI_API_KEY=gsk_xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant
# AI_MAX_TOKENS=500
# OPENROUTER_MODEL=minimax/minimax-m3  (free model; avoid the deprecated ":free" suffix –
#   if a model's free tier is removed the agent auto-switches to the slug OpenRouter recommends)
# AI_TEMPERATURE=0.4